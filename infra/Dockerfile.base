# Base optimizada: python:3.11-slim + geoespacial + NLP
# Uso: cada servicio monta su código por volumen y arranca con gunicorn.
# Build: docker compose build
FROM python:3.11-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DEBIAN_FRONTEND=noninteractive

# Dependencias sistema para GeoPandas (GDAL/GEOS/PROJ) + build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    gdal-bin \
    libgdal-dev \
    libgeos-dev \
    libproj-dev \
    libspatialindex-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Deps Python comunes (una sola capa, cacheable)
COPY requirements.analytics.txt /tmp/requirements.analytics.txt
RUN pip install --upgrade pip && pip install -r /tmp/requirements.analytics.txt \
    && pip install https://github.com/explosion/spacy-models/releases/download/es_core_news_sm-3.7.0/es_core_news_sm-3.7.0-py3-none-any.whl \
    && rm -rf /root/.cache

# Healthcheck genérico (cada servicio expone $PORT)
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8050}/ || exit 1

CMD ["gunicorn", "--help"]
